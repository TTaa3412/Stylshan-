{% extends "layouts.master" %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-stone-200">
        
        <h1 class="text-2xl md:text-3xl font-bold text-stone-800 mb-6 pb-4 border-b border-stone-100">
            {{ page.title }}
        </h1>

        {% hook 'information_page.information_page' %}

        <div class="prose max-w-none text-stone-600 leading-relaxed mt-6">
            {{ page.content | raw }}
        </div>

    </div>
</div>
{% endblock %}
