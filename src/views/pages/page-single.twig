{% extends "layouts.master" %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto bg-white rounded-xl shadow-sm p-6 md:p-8">
        <h1 class="text-2xl md:text-3xl font-bold text-stone-900 mb-6">
            {{ page.title }}
        </h1>

        <div class="salla-blocks-wrapper">
            {% hook 'information_page.information_page' %}
        </div>

        <div class="prose max-w-none text-stone-700 mt-6">
            {{ page.content | raw }}
        </div>
    </div>
</div>
{% endblock %}
