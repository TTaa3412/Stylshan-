<div class="product-card bg-white rounded-xl border border-stone-200 overflow-hidden hover:shadow-md transition group">
    <div class="relative aspect-square bg-stone-100 overflow-hidden">
        <a href="{{ product.url }}">
            <img src="{{ product.image.url }}" alt="{{ product.name }}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
        </a>
        {% if product.is_sale %}
            <span class="absolute top-2 right-2 bg-rose-500 text-white text-xs px-2 py-1 rounded-full">خصم</span>
        {% endif %}
    </div>
    
    <div class="p-4 text-right">
        <h3 class="font-bold text-stone-800 text-sm mb-2 truncate">
            <a href="{{ product.url }}">{{ product.name }}</a>
        </h3>
        
        <div class="flex items-center justify-between">
            <span class="text-stone-900 font-semibold text-sm">{{ product.price.formatted }}</span>
            <button type="button" class="bg-stone-900 text-white text-xs px-3 py-2 rounded-lg hover:bg-stone-800 transition" onclick="salla.cart.addItem({{ product.id }})">
                أضف للسلة
            </button>
        </div>
    </div>
</div>
