{% extends "layouts.master" %}

{% block content %}
<main class="main-container">
    <!-- السلايدر الرئيسي الفاخر -->
    <section class="enhanced-slider-section my-6">
        <div class="container mx-auto px-4">
            <div class="relative overflow-hidden">
                <div class="relative flex items-center">
                    <div class="relative z-10 max-w-xl">
                        <span class="text-xs tracking-wider uppercase">اكتشفي جمالك بأسلوب فاخر</span>
                        <h1 class="text-3xl md:text-4xl font-bold mt-2">مكياج، عطور ومنتجات عناية مختارة بعناية لتناسب ذوقك الراقي</h1>
                        <p class="text-lg text-gray-600 mt-2">تسوقي الآن واحصلي على أفضل العروض الحصرية.</p>
                        <a href="/categories" class="btn btn-primary mt-4">تسوق الآن</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- أقسام المنتجات أو المميزات (1، 2، 3 كاملة) -->
    <section class="store-features py-8 bg-gray-50">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- العنصر الأول -->
                <div class="p-6 bg-white rounded-lg shadow-sm">
                    <h3 class="font-bold text-lg">منتجات أصلية 100%</h3>
                    <p class="text-gray-500 text-sm mt-1">نضمن لك جودة وأصالة المنتجات.</p>
                </div>
                <!-- العنصر الثاني (الذي تم تداركه) -->
                <div class="p-6 bg-white rounded-lg shadow-sm">
                    <h3 class="font-bold text-lg">شحن سريع</h3>
                    <p class="text-gray-500 text-sm mt-1">توصيل لجميع مناطق المملكة.</p>
                </div>
                <!-- العنصر الثالث -->
                <div class="p-6 bg-white rounded-lg shadow-sm">
                    <h3 class="font-bold text-lg">دعم فني سريع</h3>
                    <p class="text-gray-500 text-sm mt-1">متواجدين لخدمتك على مدار الساعة.</p>
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}
