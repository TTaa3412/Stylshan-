{% extends "layouts.master" %}

{% block content %}
<main class="main-container">
    <!-- السلايدر الرئيسي الفاخر -->
    <section class="enhanced-slider-section my-6">
        <div class="container mx-auto px-4">
            <div class="relative overflow-hidden rounded-2xl shadow-xl bg-gray-900 text-white">
                <div class="relative flex items-center justify-center p-12 md:p-20 text-center bg-gradient-to-r from-gray-900 via-black to-gray-900">
                    <div class="relative z-10 max-w-2xl">
                        <span class="text-xs tracking-widest uppercase bg-amber-500/20 text-amber-300 px-3 py-1 rounded-full mb-4 inline-block">تشكيلة حصرية</span>
                        <h1 class="text-3xl md:text-5xl font-bold mb-4 text-white">مرحباً بك في ستايليشن</h1>
                        <p class="text-lg text-gray-300 mb-6">وجهتك الأولى للعطور الفاخرة، المكياج الراقي، وأرقى منتجات العناية.</p>
                        <a href="/categories" class="inline-block bg-amber-500 hover:bg-amber-600 text-black font-bold px-8 py-3 rounded-xl transition-all shadow-lg">تسوق الان</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- أقسام المنتجات أو المميزات -->
    <section class="store-features py-8 bg-gray-50 dark:bg-gray-900">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
                <div class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-sm">
                    <h3 class="font-bold text-lg mb-2">توصيل سريع وآمن</h3>
                    <p class="text-gray-500 text-sm">شحن لكافة مناطق المملكة بكل سرعة.</p>
                </div>
                <div class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-sm">
                    <h3 class="font-bold text-lg mb-2">منتجات أصلية 100%</h3>
                    <p class="text-gray-500 text-sm">نضمن لك الجودة والتميز في كل قطبة وعطر.</p>
                </div>
                <div class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-sm">
                    <h3 class="font-bold text-lg mb-2">دفع مرن وآمن</h3>
                    <p class="text-gray-500 text-sm">طرق دفع متعددة تشمل التقسيط المريح.</p>
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}
