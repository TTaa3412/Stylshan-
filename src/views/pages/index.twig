{% extends "layouts.master" %}

{% block content %}
<main class="main-container bg-stone-50 min-h-screen">

    <!-- شريط الإعلانات العلوي -->
    <div class="bg-stone-900 text-stone-200 text-xs py-2">
        <div class="container mx-auto flex justify-between items-center px-4">
            <div class="flex items-center gap-2">
                <span>🚚 {{ 'دعم سريع' | t }}</span>
            </div>
            <div class="text-center">
                <span>⭐ {{ 'شحن مجاني للطلبات فوق 299 ريال' | t }}</span>
            </div>
            <div class="flex items-center gap-2">
                <span>💯 {{ 'منتجات أصلية 100%' | t }}</span>
            </div>
        </div>
    </div>

    <!-- قسم العروض والواجهة الفاخرة لمتجر ستايلشان -->
    <section class="container mx-auto px-4 my-8">
        <div class="relative rounded-2xl overflow-hidden bg-stone-900 text-white p-8 md:p-12">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                
                <!-- النصوص والأزرار -->
                <div class="text-right space-y-4">
                    <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">{{ 'تشكيلة حصرية' | t }}</span>
                    <h1 class="text-3xl md:text-5xl font-bold">{{ 'أناقتك تبدأ من هنا' | t }}</h1>
                    <p class="text-stone-300 text-sm md:text-base">
                        {{ 'اكتشفي التشكيلة الرفيعة في متجر ستايلشان' | t }}
                    </p>
                    <div class="pt-2">
                        <a href="/category/offers" class="inline-block bg-white text-stone-900 font-medium px-6 py-3 rounded-xl shadow hover:bg-stone-100 transition">
                            <span>{{ 'تصفح العروض الآن' | t }}</span>
                        </a>
                    </div>
                </div>

                <!-- صورة الترويج للفخامة -->
                <div class="flex justify-center">
                    <div class="relative w-full h-48 md:h-64 flex items-center justify-center bg-stone-800 rounded-xl border border-stone-700">
                        <span class="text-stone-400 text-sm">{{ 'بانر متجر ستايلشان (Stylshan)' | t }}</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- أقسام المنتجات السريعة -->
    <section class="container mx-auto px-4 my-10">
        <div class="text-center mb-8">
            <h2 class="text-2xl font-bold text-stone-900">{{ 'الأقسام الرئيسية' | t }}</h2>
            <p class="text-stone-500 text-sm mt-1">{{ 'تصنيفاتك المفضلة' | t }}</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <a href="/category/perfumes" class="bg-white p-6 rounded-xl shadow-sm text-center hover:shadow-md transition border border-stone-100">
                <div class="w-12 h-12 bg-stone-100 rounded-full mx-auto mb-3 flex items-center justify-center text-xl">🌸</div>
                <h3 class="font-bold text-stone-800">{{ 'العطور' | t }}</h3>
            </a>
            <a href="/category/makeup" class="bg-white p-6 rounded-xl shadow-sm text-center hover:shadow-md transition border border-stone-100">
                <div class="w-12 h-12 bg-stone-100 rounded-full mx-auto mb-3 flex items-center justify-center text-xl">💄</div>
                <h3 class="font-bold text-stone-800">{{ 'المكياج' | t }}</h3>
            </a>
            <a href="/category/bags" class="bg-white p-6 rounded-xl shadow-sm text-center hover:shadow-md transition border border-stone-100">
                <div class="w-12 h-12 bg-stone-100 rounded-full mx-auto mb-3 flex items-center justify-center text-xl">👜</div>
                <h3 class="font-bold text-stone-800">{{ 'الشنط الفاخرة' | t }}</h3>
            </a>
            <a href="/category/skincare" class="bg-white p-6 rounded-xl shadow-sm text-center hover:shadow-md transition border border-stone-100">
                <div class="w-12 h-12 bg-stone-100 rounded-full mx-auto mb-3 flex items-center justify-center text-xl">✨</div>
                <h3 class="font-bold text-stone-800">{{ 'العناية' | t }}</h3>
            </a>
        </div>
    </section>

</main>
{% endblock %}
