{% extends "layouts.master" %}

{% block content %}
<main class="main-container">

    {# كود تفعيل الأقسام الديناميكية لمنع الشاشة البيضاء في لوحة سلة #}
    {% if salla.blocks %}
        {{ salla.blocks.render() }}
    {% endif %}

    <!-- شريط الإعلانات العلوي -->
    <div class="bg-stone-900 text-stone-200 text-xs py-2 px-4">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center gap-2">
                <span>🚚 دعم سريع</span>
            </div>
            <div class="text-center">
                <span>📦 شحن مجاني للطلبات فوق 299 ريال</span>
            </div>
            <div class="flex items-center gap-2">
                <span>⭐ منتجات أصلية 100%</span>
            </div>
        </div>
    </div>

    <!-- رأس الصفحة وشعار ستايلشن -->
    <header class="bg-[#FBF9F5] border-b border-stone-200 py-4 px-4 sticky top-0 z-40">
        <div class="container mx-auto flex justify-between items-center">
            
            <!-- أيقونات المتجر -->
            <div class="flex items-center gap-4 text-stone-700">
                <a href="/cart" class="relative flex items-center gap-1 hover:text-amber-700 transition">
                    <span class="bg-amber-700 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">0</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                </a>
            </div>

            <!-- الشعار -->
            <div class="text-center">
                <a href="/" class="inline-block">
                    <h1 class="text-3xl font-serif font-bold tracking-wider text-stone-900">Stylshan</h1>
                    <span class="text-[10px] uppercase tracking-widest text-stone-500 block">Beauty & Elegance</span>
                </a>
            </div>

            <!-- مربع البحث -->
            <div class="hidden lg:flex items-center w-72">
                <div class="relative w-full">
                    <input type="text" placeholder="البحث عن منتج..." class="w-full bg-stone-100 border border-stone-300 rounded-full py-2 pr-4 pl-10 text-xs focus:outline-none focus:border-stone-500">
                </div>
            </div>

        </div>

        <!-- القائمة الأفقية للأقسام -->
        <nav class="hidden md:block mt-4 border-t border-stone-200 pt-3">
            <ul class="container mx-auto flex justify-center items-center gap-8 text-sm font-medium text-stone-700">
                <li><a href="/" class="text-amber-700 font-semibold border-b-2 border-amber-700 pb-1">الرئيسية</a></li>
                <li><a href="/category/perfumes" class="hover:text-amber-700 transition">العطور</a></li>
                <li><a href="/category/makeup" class="hover:text-amber-700 transition">المكياج</a></li>
                <li><a href="/category/bags" class="hover:text-amber-700 transition">الشنط</a></li>
                <li><a href="/category/skincare" class="hover:text-amber-700 transition">العناية بالبشرة</a></li>
                <li><a href="/category/bestsellers" class="hover:text-amber-700 transition">الأكثر مبيعاً</a></li>
                <li><a href="/category/new" class="hover:text-amber-700 transition">وصل حديثاً</a></li>
                <li><a href="/category/offers" class="hover:text-amber-700 transition">العروض</a></li>
            </ul>
        </nav>
    </header>

    <!-- قسم السلايدر الرئيسي الفاخر -->
    <section class="container mx-auto px-4 my-6">
        <div class="relative rounded-2xl overflow-hidden bg-[#F2ECE1] shadow-sm py-12 md:py-16 px-6 md:px-16 flex items-center">
            
            <div class="grid grid-cols-1 md:grid-cols-2 items-center w-full gap-8">
                <!-- النصوص والأزرار -->
                <div class="text-right space-y-4">
                    <h2 class="text-3xl md:text-5xl font-bold font-serif text-stone-900 leading-tight">اكتشفي جمالك بأسلوب فاخر</h2>
                    <p class="text-stone-600 text-sm md:text-base">مكياج، عطور، شنط ومنتجات عناية مختارة بعناية لتناسب ذوقك الراقي</p>
                    <div>
                        <a href="/categories" class="inline-flex items-center gap-2 bg-stone-900 text-stone-100 px-6 py-3 rounded-xl text-sm font-medium hover:bg-stone-800 transition shadow-md">
                            <span>تسوق الآن</span>
                        </a>
                    </div>
                </div>

                <!-- صورة الترويج للفخامة -->
                <div class="flex justify-center">
                    <div class="relative w-full max-w-md h-64 md:h-80 rounded-xl overflow-hidden shadow-inner flex items-center justify-center bg-stone-200/50">
                        <span class="text-stone-500 text-xs font-medium">واجهة منتجات ستايلشن الفاخرة</span>
                    </div>
                </div>
            </div>

        </div>
    </section>

</main>
{% endblock %}
