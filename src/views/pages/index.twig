{% extends "layouts.master" %}

{% block content %}
<main class="main-container bg-stone-50 min-h-screen">

    <!-- شريط الإعلانات العلوي -->
    <div class="bg-stone-900 text-stone-200 text-xs py-2">
        <div class="container mx-auto flex justify-between items-center px-4">
            <div class="flex items-center gap-2">
                <span>🚚 دعم سريع</span>
            </div>
            <div class="text-center">
                <span>📦 شحن مجاني للطلبات فوق 299 ريال</span>
            </div>
            <div class="flex items-center gap-2">
                <span>⭐ منتجات أصلية 100%</span>
            </div>
        </div>
    </div>

    <!-- قسم العروض والواجهة الفاخرة لمتجر ستايلشان -->
    <section class="container mx-auto px-4 my-8">
        <div class="relative rounded-2xl overflow-hidden bg-[#F4EFEA] p-8 md:p-12 shadow-sm border border-stone-200">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                
                <!-- النصوص والأزرار -->
                <div class="text-right space-y-4">
                    <span class="text-xs font-semibold tracking-widest text-amber-700 uppercase bg-amber-100 px-3 py-1 rounded-full">تشكيلة حصرية</span>
                    <h1 class="text-3xl md:text-5xl font-bold text-stone-800 tracking-tight">أناقتك تبدأ من هنا</h1>
                    <p class="text-stone-600 text-sm md:text-base leading-relaxed">
                        اكتشفي أرقى العطور العالمية، مستحضرات التجميل الفاخرة، والشنط الحصرية المصممة خصيصاً لتناسب ذوقك الرفيع في متجر ستايلشان.
                    </p>
                    <div class="pt-2">
                        <a href="/category/offers" class="inline-block bg-stone-900 text-white px-8 py-3.5 rounded-full text-sm font-medium hover:bg-stone-800 transition shadow-md">
                            <span>تصفح العروض الآن</span>
                        </a>
                    </div>
                </div>

                <!-- صورة الترويج للفخامة -->
                <div class="flex justify-center">
                    <div class="relative w-full h-72 md:h-80 bg-stone-200/70 rounded-xl overflow-hidden flex flex-col items-center justify-center border border-stone-300/60 shadow-inner">
                        <svg class="w-16 h-16 text-stone-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <span class="text-stone-500 font-medium text-sm">بانر متجر ستايلشان (Stylshan)</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- أقسام المنتجات السريعة -->
    <section class="container mx-auto px-4 my-10">
        <div class="text-center mb-8">
            <h2 class="text-2xl font-bold text-stone-800">الأقسام الرئيسية</h2>
            <p class="text-stone-500 text-sm mt-1">تسوّقي حسب تصنيفاتك المفضلة</p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <a href="/category/perfumes" class="bg-white p-6 rounded-xl border border-stone-200 text-center hover:shadow-md transition group">
                <div class="w-12 h-12 bg-stone-100 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-stone-900 group-hover:text-white transition">🌸</div>
                <h3 class="font-bold text-stone-800 text-sm">العطور</h3>
            </a>
            <a href="/category/makeup" class="bg-white p-6 rounded-xl border border-stone-200 text-center hover:shadow-md transition group">
                <div class="w-12 h-12 bg-stone-100 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-stone-900 group-hover:text-white transition">💄</div>
                <h3 class="font-bold text-stone-800 text-sm">المكياج</h3>
            </a>
            <a href="/category/bags" class="bg-white p-6 rounded-xl border border-stone-200 text-center hover:shadow-md transition group">
                <div class="w-12 h-12 bg-stone-100 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-stone-900 group-hover:text-white transition">👜</div>
                <h3 class="font-bold text-stone-800 text-sm">الشنط الفاخرة</h3>
            </a>
            <a href="/category/skincare" class="bg-white p-6 rounded-xl border border-stone-200 text-center hover:shadow-md transition group">
                <div class="w-12 h-12 bg-stone-100 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-stone-900 group-hover:text-white transition">✨</div>
                <h3 class="font-bold text-stone-800 text-sm">العناية</h3>
            </a>
        </div>
    </section>

</main>
{% endblock %}
