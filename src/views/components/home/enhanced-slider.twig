{#
| Variable                  | Type    | Description |
|---------------------------|---------|-------------|
| component                 | object  |             |
| component.slides[].image  | string  |             |
| component.slides[].title  | ?string |             |
| component.slides[].description| ?string |         |
| component.slides          | object[]|             |
| position                  | int     |             |
#}
{% schema %}
{
    "name": "{{ 'السلايدر المطور' | t }}",
    "icon": "salla-icon:images",
    "description": "{{ 'بانر العرض المتحرك الفاخر' | t }}",
    "fields": [
        {
            "id": "slider_settings_group",
            "type": "group",
            "name": "{{ 'إعدادات السلايدر' | t }}",
            "settings": []
        }
    ]
}
{% endschema %}

<section class="enhanced-slider-section py-8">
    <div class="container mx-auto px-4">
        <div class="relative overflow-hidden rounded-2xl">
            <div class="flex transition-transform duration-500">
                {% for slide in component.slides %}
                    <div class="min-w-full relative">
                        {% if slide.image %}
                            <div class="absolute inset-0">
                                <img src="{{ slide.image }}" alt="{{ slide.title }}" class="w-full h-full object-cover">
                            </div>
                        {% endif %}
                        <div class="relative z-10 p-8 md:p-16 text-white">
                            {% if slide.title %}
                                <h2 class="text-3xl md:text-5xl font-extrabold mb-4">{{ slide.title }}</h2>
                            {% endif %}
                            {% if slide.description %}
                                <p class="text-stone-200 text-sm md:text-base mb-6">{{ slide.description }}</p>
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <div class="min-w-full relative bg-stone-900 text-white p-12 rounded-2xl text-center">
                        <h2 class="text-3xl font-extrabold mb-2">{{ 'أفخم العطور ومنتجات التجميل' | t }}</h2>
                        <p class="text-stone-300 text-sm">{{ 'اكتشف تشكيلة واسعة من المنتجات الحصرية في متجر ستايلشان' | t }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
