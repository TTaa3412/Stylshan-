{#
| Variable               | Type    | Description
|------------------------|---------|---------------------------------------------------
| component              | object  |
| component.slides[].image      | string  |
| component.slides[].title      | ?string |
| component.slides[].description| ?string |
| component.slides       | object[]|
| position               | int     |
#}
{% schema %}
{
  "name": "السلايدر المطور",
  "icon": "salla-icon:images",
  "description": "بانر العرض المتحرك الفاخر",
  "fields": [
    {
      "id": "slider_settings_group",
      "type": "group",
      "name": "إعدادات السلايدر",
      "settings": []
    }
  ]
}
{% endschema %}

<section class="enhanced-slider-section py-8">
    <div class="container mx-auto px-4">
        <div class="relative overflow-hidden rounded-2xl shadow-xl bg-gray-900 text-white">
            <div class="flex transition-transform duration-500 ease-in-out">
                {% for slide in component.slides %}
                    <div class="min-w-full relative flex items-center justify-center p-8 md:p-16">
                        {% if slide.image %}
                            <div class="absolute inset-0 z-0">
                                <img src="{{ slide.image }}" alt="{{ slide.title }}" class="w-full h-full object-cover opacity-60">
                            </div>
                        {% endif %}
                        <div class="relative z-10 text-center max-w-2xl">
                            {% if slide.title %}
                                <h2 class="text-3xl md:text-5xl font-bold mb-4 text-white drop-shadow-md">{{ slide.title }}</h2>
                            {% endif %}
                            {% if slide.description %}
                                <p class="text-lg md:text-xl text-gray-200 mb-6 drop-shadow">{{ slide.description }}</p>
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <div class="min-w-full relative flex items-center justify-center p-12 text-center bg-gradient-to-r from-gray-900 to-black">
                        <div class="relative z-10 max-w-xl">
                            <h2 class="text-3xl md:text-4xl font-bold mb-3 text-white">أهلاً بك في ستايليشن</h2>
                            <p class="text-lg text-gray-300">متجرك الراقي للعطور والمكياج ومنتجات العناية الفاخرة.</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
