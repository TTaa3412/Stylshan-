<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl()? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') | raw }}

    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'js/app.js' | cdn }}"></script>
    {% if theme.settings.get('enable_add_product_toast', true) %}
    <script defer src="{{ 'add-product-toast.js' | cdn }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}

    {% hook 'head:start' %}
    {% hook 'head' %}
    {% block styles %}{% endblock %}

    <link rel="stylesheet" href="{{ 'app.css' | cdn }}">
    <link rel="stylesheet" href="{{ theme.font.css | cdn }}">
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css' | cdn }}">

    <style>
        :root {
            --font-main: '{{ theme.font.name }}';
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.primary_dark }};
            --color-primary-light: {{ theme.color.primary_light }};
            --color-primary-reverse: {{ theme.color.primary_reverse }};
        }
    </style>

    {% hook 'head:end' %}
</head>
<body id="app" class="theme-raed overflow-x-hidden">
<div class="app-inner flex flex-col min-h-full">
    {% hook 'body:start' %}
    {% component 'header.header' %}
    <salla-search></salla-search>

    <main id="main-content" role="main">
        {% block content %}{% endblock %}
    </main>
    {% component 'footer.footer' %}
</div>
{% hook 'body:end' %}

<salla-offer-modal></salla-offer-modal>
<salla-search></salla-search>
<salla-login-modal></salla-login-modal>

{# الهوك المطلوب رسمياً من سلة لإضافة المنتج #}
<salla-add-product></salla-add-product>

</body>
</html>
